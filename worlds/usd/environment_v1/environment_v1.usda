#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1.0
    upAxis = "Y"
    doc = "PharmaVerse Environment V1 — OpenUSD packaging cell for line-clearance simulation"
)

def Xform "World"
{
    custom string pharmaverse:stageId = "environment_v1"
    custom string pharmaverse:experiment = "line_clearance_01"
    custom string pharmaverse:expectedState = "CLEAR"

    def Xform "Marble"
    {
        custom string pharmaverse:worldId = "850b4709-cabf-4643-8bf6-5cc187e85fa4"
        custom double pharmaverse:metricScaleFactor = 1.66379
        custom double pharmaverse:groundPlaneOffset = 1.79193
        custom string pharmaverse:coordinateNote = "Marble OpenCV (+x left, +y down, +z forward). Collider rotateXYZ -90 X for Isaac Sim."
        double3 xformOp:translate = (0, -1.79193, 0)
        float3 xformOp:scale = (1.66379, 1.66379, 1.66379)
        uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
        def Xform "Splat"
        {
            custom string pharmaverse:role = "gaussian_splat"
            custom string pharmaverse:status = "pending_nurec_conversion"
        }
        def Xform "Collider" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            custom string pharmaverse:status = "pending_collider_mesh"
            custom string pharmaverse:role = "collider"
            bool physics:collisionEnabled = 1
            token visibility = "invisible"
            float3 xformOp:rotateXYZ = (-90, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }

    def Cube "GroundPlane" (
        prepend apiSchemas = ["SemanticsAPI:Semantics", "PhysicsCollisionAPI"]
    )
    {
        token semantic:Semantics:params:semanticType = "class"
        string semantic:Semantics:params:semanticData = "floor"
        custom string pharmaverse:semanticClass = "floor"
        double size = 1
        color3f[] primvars:displayColor = [(0.34, 0.35, 0.38)]
        double3 xformOp:translate = (0, -0.01, 0)
        float3 xformOp:scale = (12, 0.02, 8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        bool physics:collisionEnabled = 1
    }

    def Cube "ReferenceMeterCube"
    {
